# Application
APP_NAME=orbit-pilot
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./orbit_pilot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/orbit_pilot

# LLM Providers (configure at least one)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-3-haiku-20240307
# LLM_BASE_URL=https://api.anthropic.com
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=orbit-pilot
KEYCLOAK_CLIENT_ID=orbit-pilot-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=orbit-pilot
VITE_KEYCLOAK_CLIENT_ID=orbit-pilot-frontend

# Demo mode (localhost only, refuses in production)
DEMO_MODE=true